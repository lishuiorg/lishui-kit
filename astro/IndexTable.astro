---
/* 索引表：全部条目按年代序分组的总览，供「有没有写」的快速核对。
   groups 由站点算好：{ key, name, range, items }，末尾一组通常是无年份的条目。 */
const { groups = [], ctx } = Astro.props;
const { ui } = ctx;
const cols = [
  ui.indexPage.colYear, ui.indexPage.colEntry,
  ui.indexPage.colType, ui.indexPage.colCategory, ui.indexPage.colDepth,
];
const filled = groups.filter((group) => group.items.length > 0);
---

<div class="tablewrap">
  <table class="indextable">
    <thead>
      <tr>{cols.map((col) => <th scope="col">{col}</th>)}</tr>
    </thead>
    {filled.map((group) => (
      <tbody data-search-group>
        <tr class="indextable__group">
          <td colspan="5">
            {group.name}{group.range ? ` · ${group.range}` : ''} ·{' '}
            <span data-group-count data-unit={ui.list.countUnit}>
              {group.items.length} {ui.list.countUnit}
            </span>
          </td>
        </tr>
        {group.items.map((entry) => {
          const y = ctx.axisYear(entry);
          return (
            <tr {...ctx.filterAttrs(entry)}>
              <td class="indextable__year">{y.main}{y.sub && <small>{y.sub}</small>}</td>
              <td class="indextable__entry">
                <a href={entry.path}>{entry.title}</a>
                {entry.subtitle && <span class="indextable__sub">{entry.subtitle}</span>}
              </td>
              <td data-col="type" data-label={ui.indexPage.colType}>{ctx.typeLabel(entry)}</td>
              <td data-col="category" data-label={ui.indexPage.colCategory}>{ctx.catLabel(entry)}</td>
              <td data-col="depth" data-label={ui.indexPage.colDepth}>{ctx.depthLabel(entry)}</td>
            </tr>
          );
        })}
      </tbody>
    ))}
  </table>
</div>
<p class="noresult" data-noresult data-visible="false">{ui.list.noresult}</p>
