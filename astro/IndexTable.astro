---
/* 索引表：全部条目分组的总览，供「有没有写」的快速核对。
   groups 由站点算好：{ key, name, range, items }。
   columns 由站点给出列序，取值为 year / entry / type / category / itemtype / level /
   unittype / parent / village / featuretype / basin / districttowns / depth；
   历史站按年代分组、首列是年份，文化站按类别分组、首列是条目，
   街镇站按类别分组，列出单元类型、所属镇街与传统村落三列，
   山水站按类别分组、单列所属流域，列出实体类型、所属流域与跨涉镇街三列。 */
const { groups = [], ctx, columns = ['year', 'entry', 'type', 'category', 'depth'] } = Astro.props;
const { ui } = ctx;
const LABEL = {
  year: ui.indexPage.colYear,
  entry: ui.indexPage.colEntry,
  type: ui.indexPage.colType,
  category: ui.indexPage.colCategory,
  itemtype: ui.indexPage.colItemType,
  level: ui.indexPage.colLevel,
  unittype: ui.indexPage.colUnitType,
  parent: ui.indexPage.colParent,
  village: ui.indexPage.colVillage,
  featuretype: ui.indexPage.colFeatureType,
  basin: ui.indexPage.colBasin,
  districttowns: ui.indexPage.colDistrictTowns,
  depth: ui.indexPage.colDepth,
};
const cols = columns.map((key) => ({ key, label: LABEL[key] }));
const filled = groups.filter((group) => group.items.length > 0);
---

<div class="tablewrap">
  <table class="indextable">
    <thead>
      <tr>{cols.map((col) => <th scope="col">{col.label}</th>)}</tr>
    </thead>
    {filled.map((group) => (
      <tbody data-search-group>
        <tr class="indextable__group">
          <td colspan={cols.length}>
            {group.range ? `${group.name} · ${group.range} · ` : `${group.name} · `}
            <span data-group-count data-unit={ui.list.countUnit}>
              {group.items.length} {ui.list.countUnit}
            </span>
          </td>
        </tr>
        {group.items.map((entry) => {
          const y = ctx.axisYear(entry);
          return (
            <tr {...ctx.filterAttrs(entry)}>
              {columns.map((key) => {
                if (key === 'year') {
                  return <td class="indextable__year">{y.main}{y.sub && <small>{y.sub}</small>}</td>;
                }
                if (key === 'entry') {
                  return (
                    <td class="indextable__entry">
                      <a href={entry.path}>{entry.title}</a>
                      {entry.subtitle && <span class="indextable__sub">{entry.subtitle}</span>}
                    </td>
                  );
                }
                const value = key === 'type' ? ctx.typeLabel(entry)
                  : key === 'category' ? ctx.catLabel(entry)
                    : key === 'itemtype' ? (entry.item_type ? ctx.enumLabel('itemType', entry.item_type) : '')
                      : key === 'level' ? (entry.level ? ctx.enumLabel('level', entry.level) : '')
                        : key === 'unittype' ? (entry.unit_type ? ctx.enumLabel('unitType', entry.unit_type) : '')
                          : key === 'parent' ? (entry.parentEntry?.title || '')
                            : key === 'village' ? (entry.traditional_village ? ctx.gloss(entry.traditional_village, ctx.lang) : '')
                              : ctx.depthLabel(entry);
                return <td data-col={key} data-label={LABEL[key]}>{value}</td>;
              })}
            </tr>
          );
        })}
      </tbody>
    ))}
  </table>
</div>
<p class="noresult" data-noresult data-visible="false">{ui.list.noresult}</p>
